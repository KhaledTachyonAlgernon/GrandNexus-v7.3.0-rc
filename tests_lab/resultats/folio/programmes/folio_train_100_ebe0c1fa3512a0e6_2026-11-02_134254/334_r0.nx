scottish_team(st_johnstone). @ "St Johnstone is a Scottish team."
part_of(st_johnstone, scottish_premiership). @ "St Johnstone is part of the Scottish Premiership league."
part_of(T, L) => joined(T, L). @ "If a team is part of the league, it has joined the league."
team(st_johnstone). @ "St Johnstone and Minsk are different teams."
team(minsk). @ "St Johnstone and Minsk are different teams."
won(minsk, st_johnstone). @ "Minsk won against St Johnstone."
? won(st_johnstone, minsk).
