zaha_style(X) & adored(X) => interesting_geometries(X). @ "All of Zaha Hadid's design styles that Max adores have interesting geometries."
brutalist(X) & adored(X) => not interesting_geometries(X). @ "No brutalist buildings that Max adores have interesting geometries."
# cannot express: "Every style that Max adores is either Zaha Hadid's design style or Kelly Wearstler's design style."
wearstler_style(X) & adored(X) => evocative(X). @ "All of Kelly Wearstler's design styles that Max adores are evocative."
wearstler_style(X) & adored(X) => dreamy(X). @ "All of Kelly Wearstler's design styles that Max adores are dreamy."
design_by_max(X) & adored(X) & interesting_geometries(X) => brutalist(X). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
design_by_max(X) & adored(X) & interesting_geometries(X) => evocative(X). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
* evocative(X) => evocative_or_dreamy(X).
* dreamy(X) => evocative_or_dreamy(X).
? design_by_max(X) & evocative_or_dreamy(X).
