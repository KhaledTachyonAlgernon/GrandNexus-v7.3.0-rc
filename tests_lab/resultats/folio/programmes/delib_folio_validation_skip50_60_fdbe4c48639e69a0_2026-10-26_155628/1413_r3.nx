can_register(X) => can_participate(X). @ "Everyone who can register to vote in the United States can participate in the 2024 United States presidential election."
us_citizen(X) => can_register(X). @ "If someone has United States citizenship, then they can register to vote in the United States."
person(X) & not taiwanese_citizen(X) => us_citizen(X). @ "A person either has United States citizenship or Taiwanese citizenship."
person(X) & not us_citizen(X) => taiwanese_citizen(X). @ "A person either has United States citizenship or Taiwanese citizenship."
russian_official(X) => not taiwanese_citizen(X). @ "No Russian Federation officials hold Taiwanese citizenship."
not taiwanese_citizen(vladimir). @ "Vladimir neither holds Taiwanese citizenship"
not manager_gazprom(vladimir). @ "nor is he a manager at Gazprom"
person(ekaterina). @ "Ekaterina"
person(vladimir). @ "Vladimir"
not can_register(ekaterina) => russian_official(ekaterina). @ "Ekaterina she can register to vote in the United States, or she is a Russian federation official."
can_participate(ekaterina) => goal. @ "Ekaterina can participate in the 2024 United States presidential election"
manager_gazprom(vladimir) => goal. @ "Vladimir is a manager at Gazprom"
? goal.
