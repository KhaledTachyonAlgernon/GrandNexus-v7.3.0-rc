pro_player(some_player_1). @ "Some professional basketball players are not American nationals."
not american(some_player_1). @ "Some professional basketball players are not American nationals."
pro_player(X) => jump_shots(X). @ "All professional basketball players can do jump shots."
jump_shots(X) => leaps(X). @ "If someone can jump shots, they leap straight into the air."
leaps(X) => leg_muscles(X). @ "If someone leaps straight into the air, they activate their leg muscles."
not leg_muscles(yuri). @ "Yuri does not activate his leg muscles."
* american_pro(X) => pro_player(X).
? not leaps(yuri) => american_pro(yuri).
