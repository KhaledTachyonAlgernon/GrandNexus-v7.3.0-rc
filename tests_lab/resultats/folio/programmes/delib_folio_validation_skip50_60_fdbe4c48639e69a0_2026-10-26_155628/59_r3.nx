japanese_game_company(some_company_1). @ "A Japanese game company"
created(some_company_1, zelda). @ "created the game the Legend of Zelda"
game(zelda). @ "the game the Legend of Zelda"
game(G) & on_top10(G) => made_by_japanese_company(G). @ "All games on the Top 10 list are made by Japanese game companies."
game(G) & sells_over_million(G) => on_top10(G). @ "If a game sells more than one million copies, then it will be included in the Top 10 list."
sells_over_million(zelda). @ "The Legend of Zelda sold more than one million copies."
? not on_top10(zelda).
