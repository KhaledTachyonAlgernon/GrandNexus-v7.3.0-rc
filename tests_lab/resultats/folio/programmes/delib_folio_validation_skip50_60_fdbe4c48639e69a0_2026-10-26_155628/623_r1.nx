music_piece(symphony_no_9). @ "Symphony No. 9 is a music piece."
# cannot express: "Composers write music pieces."
wrote(beethoven, symphony_no_9). @ "Beethoven wrote Symphony No. 9."
premiered(vienna_music_society, symphony_no_9). @ "Vienna Music Society premiered Symphony No. 9."
orchestra(vienna_music_society). @ "Vienna Music Society is an orchestra."
leads(beethoven, vienna_music_society). @ "Beethoven leads the Vienna Music Society."
orchestra(O) & leads(X, O) => conductor(X). @ "Orchestras are led by conductors."
? not conductor(beethoven).
