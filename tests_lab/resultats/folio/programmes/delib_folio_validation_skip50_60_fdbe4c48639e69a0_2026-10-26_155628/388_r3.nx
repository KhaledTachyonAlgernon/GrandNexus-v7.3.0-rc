ml_category(supervised). @ "Machine Learning algorithms can be categorized as supervised learning"
ml_category(unsupervised). @ "unsupervised learning"
ml_category(reinforcement). @ "reinforcement learning"
not requires_labeled(unsupervised). @ "Unsupervised learning algorithms do not require labeled data"
not used_to_train(reinforcement, sota_summarizer). @ "Reinforcement learning is not used to train the state-of-the-art text summarization model"
requires_labeled(ts_ml_algorithm). @ "The Machine Learning algorithm for training text summarization models requires labeled data"
# cannot express: "The state-of-the-art text summarization model is trained with machine learning algorithms."
? used_to_train(supervised, sota_summarizer).
