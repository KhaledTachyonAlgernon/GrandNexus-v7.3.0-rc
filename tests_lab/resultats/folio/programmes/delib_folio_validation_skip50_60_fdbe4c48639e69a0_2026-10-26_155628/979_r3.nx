at_school(X) & work_job(X) => need_money(X). @ "If people at Mary's school work in student jobs on campus, then they need to earn money to help pay for their college tuition."
at_school(X) & order_takeout(X) => work_job(X). @ "If people at Mary's school order takeout frequently in college, then they work in student jobs on campus."
# cannot express: "People at Mary's school order takeout frequently in college or enjoy the dining hall meals and recipes."
at_school(X) & enjoy_dining(X) => not picky(X). @ "If people at Mary's school enjoy the dining hall meals and recipes, then they are not picky eaters."
at_school(X) & enjoy_dining(X) => spend_time_dining(X). @ "If people at Mary's school enjoy the dining hall meals and recipes, then they spend a lot of their time eating and catching up with friends in the campus dining halls."
at_school(hannah). @ "Hannah is at Mary's school."
work_job(hannah). @ "Hannah works in student jobs on campus"
need_money(hannah) => not picky(hannah). @ "if she needs to earn money to help pay for her college tuition, then she is neither picky nor needs to earn money to help pay for her college tuition"
need_money(hannah) => not need_money(hannah). @ "if she needs to earn money to help pay for her college tuition, then she is neither picky nor needs to earn money to help pay for her college tuition"
? need_money(hannah).
