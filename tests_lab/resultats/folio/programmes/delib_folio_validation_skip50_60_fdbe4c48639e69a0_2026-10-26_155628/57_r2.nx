japanese_game_company(creator_of_zelda). @ "A Japanese game company created the game the Legend of Zelda."
created(creator_of_zelda, zelda). @ "A Japanese game company created the game the Legend of Zelda."
game(zelda). @ "the game the Legend of Zelda"
game(G) & top10(G) & created(C, G) => japanese_game_company(C). @ "All games on the Top 10 list are made by Japanese game companies."
game(G) & sold_over_million(G) => top10(G). @ "If a game sells more than one million copies, then it will be included in the Top 10 list."
sold_over_million(zelda). @ "The Legend of Zelda sold more than one million copies."
? top10(zelda).
