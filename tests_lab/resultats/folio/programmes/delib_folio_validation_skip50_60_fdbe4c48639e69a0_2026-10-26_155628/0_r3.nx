wild_turkey(X) & not eastern(X) & not osceola(X) => rest1(X). @ "There are six types of wild turkeys: Eastern wild turkey, Osceola wild turkey, Gould’s wild turkey, Merriam’s wild turkey, Rio Grande wild turkey, and Ocellated wild turkey."
rest1(X) & not goulds(X) & not merriams(X) => rest2(X). @ "There are six types of wild turkeys: Eastern wild turkey, Osceola wild turkey, Gould’s wild turkey, Merriam’s wild turkey, Rio Grande wild turkey, and Ocellated wild turkey."
rest2(X) & not rio_grande(X) => ocellated(X). @ "There are six types of wild turkeys: Eastern wild turkey, Osceola wild turkey, Gould’s wild turkey, Merriam’s wild turkey, Rio Grande wild turkey, and Ocellated wild turkey."
not eastern(tom). @ "Tom is not an Eastern wild turkey."
not osceola(tom). @ "Tom is not an Osceola wild turkey."
not goulds(tom). @ "Tom is not a Gould's wild turkey."
not merriams(tom). @ "Tom is neither a Merriam's wild turkey nor a Rio Grande wild turkey."
not rio_grande(tom). @ "Tom is neither a Merriam's wild turkey nor a Rio Grande wild turkey."
wild_turkey(tom). @ "Tom is a wild turkey."
? ocellated(tom).
