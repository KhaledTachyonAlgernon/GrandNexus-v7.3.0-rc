pro_bb(some_player_1). @ "Some professional basketball players"
not american(some_player_1). @ "are not American nationals"
pro_bb(X) => jump_shots(X). @ "All professional basketball players can do jump shots."
jump_shots(X) => leaps_up(X). @ "If someone can jump shots, they leap straight into the air."
leaps_up(X) => leg_muscles(X). @ "If someone leaps straight into the air, they activate their leg muscles."
not leg_muscles(yuri). @ "Yuri does not activate his leg muscles."
? not american_pro_bb(yuri) => pro_bb(yuri).
