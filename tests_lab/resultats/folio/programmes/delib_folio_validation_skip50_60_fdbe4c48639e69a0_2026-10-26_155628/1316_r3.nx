pro_player(some_player_1). @ "Some professional basketball players"
not american(some_player_1). @ "are not American nationals"
pro_player(X) => jump_shot(X). @ "All professional basketball players can do jump shots."
jump_shot(X) => leap(X). @ "If someone can jump shots, they leap straight into the air."
leap(X) => leg_muscles(X). @ "If someone leaps straight into the air, they activate their leg muscles."
not leg_muscles(yuri). @ "Yuri does not activate his leg muscles."
* pro_player(X) & american(X) => american_pro_player(X).
? not leap(yuri) => american_pro_player(yuri).
