alien(X) => extraterrestrial(X). @ "All aliens are extraterrestrials."
from_mars(X) => alien(X). @ "If someone is from Mars, then they are an alien."
extraterrestrial(X) => not human(X). @ "No extraterrestrials are human."
highly_intelligent(X) & from_earth(X) => human(X). @ "All highly intelligent beings from Earth are humans."
highly_intelligent(marvin). @ "Marvin is a highly intelligent being."
from_earth(marvin) => from_mars(marvin). @ "Marvin is either from Earth and from Mars, or he is from neither."
from_mars(marvin) => from_earth(marvin). @ "Marvin is either from Earth and from Mars, or he is from neither."
not from_earth(marvin) => not from_mars(marvin). @ "Marvin is either from Earth and from Mars, or he is from neither."
not from_mars(marvin) => not from_earth(marvin). @ "Marvin is either from Earth and from Mars, or he is from neither."
not from_earth(marvin) => extraterrestrial(marvin). @ "If Marvin is not from Earth, then Marvin is an extraterrestrial."
? not human(marvin) & not from_mars(marvin).
