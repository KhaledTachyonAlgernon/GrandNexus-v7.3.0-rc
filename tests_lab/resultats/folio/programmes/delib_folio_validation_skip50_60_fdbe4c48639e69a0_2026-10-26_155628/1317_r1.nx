pbp(some_pbp_1). @ "Some professional basketball players"
not american(some_pbp_1). @ "are not American nationals"
pbp(X) => jump_shots(X). @ "All professional basketball players can do jump shots."
jump_shots(X) => leap(X). @ "If someone can jump shots, they leap straight into the air."
leap(X) => leg_muscles(X). @ "If someone leaps straight into the air, they activate their leg muscles."
not leg_muscles(yuri). @ "Yuri does not activate his leg muscles."
* american_pbp(X) => pbp(X).
? not american_pbp(yuri) => pbp(yuri).
