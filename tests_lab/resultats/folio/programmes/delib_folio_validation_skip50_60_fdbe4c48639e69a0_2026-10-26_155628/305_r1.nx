same(ailton_silva, ailton). @ "Ailton Silva, born in 1995, is commonly known as Ailton"
born_in(ailton_silva, 1995). @ "Ailton Silva, born in 1995"
football_player(ailton). @ "Ailton is a football player"
loaned_to(ailton, braga). @ "was loaned out to Braga"
brazilian(ailton_silva). @ "Ailton Silva is a Brazilian footballer"
footballer(ailton_silva). @ "Ailton Silva is a Brazilian footballer"
plays_for(ailton_silva, nautico). @ "who plays for Náutico"
football_club(nautico). @ "Náutico is a football club"
football_club(braga). @ "Náutico is a football club along with Braga"
football_club(fluminense). @ "Fluminense is a football club"
? football_club(C) => not plays_for(ailton_silva, C).
