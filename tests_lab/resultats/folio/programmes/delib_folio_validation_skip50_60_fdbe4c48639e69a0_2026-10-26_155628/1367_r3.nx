animal(V) & not vertebrate(V) => invertebrate(V). @ "Animals are either invertebrates or vertebrates."
animal(V) & not invertebrate(V) => vertebrate(V). @ "Animals are either invertebrates or vertebrates."
vertebrate(V) => not invertebrate(V). @ "Animals are either invertebrates or vertebrates."
animal(V) & backbone(V) => mm_reproduce(V). @ "All animals with backbones reproduce by male-and-female mating."
vertebrate(V) => backbone(V). @ "All vertebrate animals have a backbone."
bee(V) => not mm_reproduce(V). @ "All bees do not reproduce by male-and-female mating."
queen_bee(V) => bee(V). @ "All queen bees are bees."
bee(harry). @ "Harry is a bee."
* bee(V) => animal(V).
* vertebrate(V) => animal(V).
* invertebrate(V) => invertebrate_or_queen(V).
* queen_bee(V) => invertebrate_or_queen(V).
? invertebrate_or_queen(harry).
