baked_sweet(V) => not spicy(V). @ "No baked sweets are spicy."
cupcake(V) => baked_sweet(V). @ "All cupcakes are baked sweets."
mala_hotpot(V) => spicy(V). @ "All mala hotpots are spicy."
melissa_product(V) => cupcake(V). @ "All products from Baked by Melissa are cupcakes."
# cannot express: "Dried Thai chilies are spicy or mala hotpots or not baked sweets."
? cupcake(dried_thai_chilies) & melissa_product(dried_thai_chilies).
