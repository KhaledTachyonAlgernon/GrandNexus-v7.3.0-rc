deadly_disease(X) => low_survival_rate(X). @ "If something is a deadly disease, then it comes with a low survival rate."
severe_cancer(X) => deadly_disease(X). @ "Severe cancers are deadly diseases."
severe_cancer(bile_duct_cancer). @ "Bile duct cancer is a severe form cancer."
cholangiocarcinoma(X) => bile_duct_cancer(X). @ "All Cholangiocarcinoma is bile duct cancer."
low_survival_rate(mild_flu). @ "Mild flu comes with a low survival rate."
bile_duct_cancer(colorectal_cancer) => not low_survival_rate(colorectal_cancer). @ "Colorectal cancer is not both a bile duct cancer and with a low survival rate."
? severe_cancer(colorectal_cancer).
