wild_turkey(tom). @ "Tom is a wild turkey"
not eastern(tom). @ "Tom is not an Eastern wild turkey"
not osceola(tom). @ "Tom is not an Osceola wild turkey"
not gould(tom). @ "Tom is not a Gould's wild turkey"
not merriam(tom). @ "Tom is neither a Merriam's wild turkey nor a Rio Grande wild turkey"
not rio_grande(tom). @ "Tom is neither a Merriam's wild turkey nor a Rio Grande wild turkey"
wild_turkey(X) & not eastern(X) & not osceola(X) => rest1(X). @ "There are six types of wild turkeys"
rest1(X) & not gould(X) & not merriam(X) => rest2(X). @ "There are six types of wild turkeys"
rest2(X) & not rio_grande(X) => ocellated(X). @ "There are six types of wild turkeys"
? ocellated(tom).
