employee(X) & schedule_meeting(X) => go_building(X). @ "All employees who schedule a meeting with their customers will go to the company building today."
lunch_building(X) => schedule_meeting(X). @ "Everyone who has lunch in the company building schedules meetings with their customers."
employee(X) & not lunch_building(X) => lunch_home(X). @ "Employees have lunch either in the company building or at home."
lunch_home(X) => remote(X). @ "If an employee has lunch at home, they are working remotely from home."
employee(X) & other_country(X) => remote(X). @ "All employees who are in other countries work remotely from home."
manager(X) => not remote(X). @ "No managers work remotely from home."
appear(james) => manager(james). @ "James will appear in the company today if and only if he is a manager."
manager(james) => appear(james). @ "James will appear in the company today if and only if he is a manager."
# cannot express: "then James does not either has lunch at home or work remotely from home" as a disjunctive conclusion; only the "not remote" part is asked
# cannot express: "If James either has lunch at home or works remotely from home, then he is neither a manager nor does he work in other countries." (second sentence, only one question allowed)
* manager(X) => manager_or_other(X).
* other_country(X) => manager_or_other(X).
? manager_or_other(james) => not remote(james).
