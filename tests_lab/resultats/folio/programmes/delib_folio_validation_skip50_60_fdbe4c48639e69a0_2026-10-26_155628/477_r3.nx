# cannot express: "The security deposit can be either equal to the monthly rent at a managed building or more."
managed_building(some_b_1). @ "Pets are allowed in some managed buildings."
allows_pets(some_b_1). @ "Pets are allowed in some managed buildings."
managed_building(B) => deposit_required(B). @ "A deposit is required to rent an apartment in a managed building."
owner(tom, fluffy). @ "Fluffy is Tom's cat."
cat(fluffy). @ "Fluffy is Tom's cat."
cat(X) => pet(X). @ "Cats are pets."
managed_building(olive_garden). @ "The Olive Garden is a managed building."
monthly_rent(olive_garden, 2000). @ "The monthly rent at the Olive Garden is $2000."
more_than(2000, 1500). @ "$2000 is more than $1500."
allowed_move_in(tom, fluffy, B) & managed_building(B) & deposit_at_most_1500(B) => rents(tom, B). @ "Tom will rent an apartment in a managed building if he is allowed to move in with Fluffy, and the security deposit is no more than $1500."
allows_pets(B) & owner(X, P) & pet(P) => allowed_move_in(X, P, B). @ "If a managed building allows pets, then people are allowed to move in with a pet."
? allowed_move_in(tom, fluffy, olive_garden).
