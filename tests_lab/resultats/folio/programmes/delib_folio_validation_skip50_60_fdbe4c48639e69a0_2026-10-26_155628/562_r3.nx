gre_applicant(X) & economic_hardship(X) => financial_aid(X). @ "ETS provides financial aid to those GRE applicants who prove economic hardship."
single_parent_family(X) => economic_hardship(X). @ "Those living in single-parent families or having few resources available to them can prove economic hardship."
few_resources(X) => economic_hardship(X). @ "Those living in single-parent families or having few resources available to them can prove economic hardship."
single_parent_family(tom). @ "Tom lives in a single-parent family."
few_resources(tom). @ "Tom has few resources available to them."
gre_applicant(tom). @ "Tom is applying to take the GRE test."
? gre_applicant(V) => not financial_aid(V).
