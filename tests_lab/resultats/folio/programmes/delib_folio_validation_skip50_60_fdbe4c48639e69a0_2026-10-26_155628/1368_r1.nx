animal(X) & not vertebrate(X) => invertebrate(X). @ "Animals are either invertebrates or vertebrates."
animal(X) & not invertebrate(X) => vertebrate(X). @ "Animals are either invertebrates or vertebrates."
vertebrate(X) => not invertebrate(X). @ "Animals are either invertebrates or vertebrates."
backbone(X) => reproduce_mating(X). @ "All animals with backbones reproduce by male-and-female mating."
vertebrate(X) => backbone(X). @ "All vertebrate animals have a backbone."
bee(X) => not reproduce_mating(X). @ "All bees do not reproduce by male-and-female mating."
queen_bee(X) => bee(X). @ "All queen bees are bees."
bee(harry). @ "Harry is a bee."
* bee(X) => animal(X).
* vertebrate(X) => animal(X).
# cannot express: "If Harry is either both a vertebrate and an animal with a backbone, or neither a vertebrate nor an animal with a backbone, then"
? not invertebrate(harry) & not queen_bee(harry).
