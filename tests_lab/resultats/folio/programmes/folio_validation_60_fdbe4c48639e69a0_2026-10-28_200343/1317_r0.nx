pro_bb(some_pro_1). @ "Some professional basketball players"
not american(some_pro_1). @ "are not American nationals"
pro_bb(V) => jump_shot(V). @ "All professional basketball players can do jump shots."
jump_shot(V) => leap(V). @ "If someone can jump shots, they leap straight into the air."
leap(V) => leg_muscles(V). @ "If someone leaps straight into the air, they activate their leg muscles."
not leg_muscles(yuri). @ "Yuri does not activate his leg muscles."
? not american_pro_bb(yuri) => pro_bb(yuri).
