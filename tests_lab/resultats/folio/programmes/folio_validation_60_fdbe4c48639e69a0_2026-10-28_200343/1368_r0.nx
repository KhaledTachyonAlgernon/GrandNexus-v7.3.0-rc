animal(V) => invertebrate(V) | vertebrate(V). @ "Animals are either invertebrates or vertebrates."
animal(V) & backbone(V) => mating(V). @ "All animals with backbones reproduce by male-and-female mating."
vertebrate(V) => backbone(V). @ "All vertebrate animals have a backbone."
bee(V) => not mating(V). @ "All bees do not reproduce by male-and-female mating."
queen_bee(V) => bee(V). @ "All queen bees are bees."
bee(harry). @ "Harry is a bee."
* bee(V) => animal(V).
? not vertebrate(harry) & not backbone(harry) => not invertebrate(harry).
