season(spring). @ "Spring"
season(summer). @ "Summer"
season(fall). @ "Fall"
season(winter). @ "Winter"
student(V) & wants_long_vacation(V) => favorite(V, summer). @ "All students who want to have a long vacation have summer as their favorite season"
favorite(emma, summer). @ "Emma's favorite season is summer"
favorite(emma, S) => not favorite(mia, S). @ "Mia's favorite season is not the same as Emma's"
wants_long_vacation(james). @ "James wants to have a long vacation"
? favorite(mia, spring).
