not novel(podcast). @ "A podcast is not a novel."
born_in(P, american_city) => american(P). @ "If a person is born in American City, the person is American."
novel(B) & written_by(B, P) => novel_writer(P). @ "If a book is a novel and it is written by a person, then the person is a novel writer."
american(dani_shapiro). @ "Dani Shapiro is an American writer."
writer(dani_shapiro). @ "Dani Shapiro is an American writer."
written_by(family_history, dani_shapiro). @ "Family History is written by Dani Shapiro."
novel(family_history). @ "Family History is a novel written in 2003."
written_in(family_history, y2003). @ "Family History is a novel written in 2003."
created(dani_shapiro, family_secrets). @ "Dani Shapiro created a podcast called Family Secrets."
podcast(family_secrets). @ "Dani Shapiro created a podcast called Family Secrets."
american_city(boston). @ "Boston is an American city."
? born_in(dani_shapiro, boston).
