member_of(some_member_1, pappys). @ "starring members of Pappy's"
starred_in(some_member_1, badults). @ "starring members of Pappy's"
piloted_on(badults, bbc_three). @ "Badults was piloted in July 2013 on BBC Three"
* starred_in(X, S) & piloted_on(S, bbc_two) => starred_in_bbc2_or_3_show(X).
* starred_in(X, S) & piloted_on(S, bbc_three) => starred_in_bbc2_or_3_show(X).
? member_of(X, pappys) => not starred_in_bbc2_or_3_show(X).
