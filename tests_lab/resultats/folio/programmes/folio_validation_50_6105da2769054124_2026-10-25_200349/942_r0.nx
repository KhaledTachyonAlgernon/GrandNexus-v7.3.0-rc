eat_salads(V) => health_conscious(V). @ "All people who eat salads regularly are very conscious about their health and eating habits."
healthy_home(V) => eat_salads(V). @ "All people who grew up in health-conscious childhood homes eat salads regularly."
fulfill_nutrition(V) => healthy_home(V). @ "All people who fulfill their daily nutritional intakes grew up in health-conscious childhood homes."
disregard_wellbeing(V) => not health_conscious(V). @ "All people who disregard their physical well-being are not very conscious about their health and eating habits."
gym_daily(V) => fulfill_nutrition(V). @ "If people visit the gym at least once a day, then they always fulfill their daily nutritional intakes."
healthy_home(taylor) => disregard_wellbeing(taylor). @ "Taylor either grew up in a health-conscious childhood home and disregard her physical well-being, or she did neither."
disregard_wellbeing(taylor) => healthy_home(taylor). @ "Taylor either grew up in a health-conscious childhood home and disregard her physical well-being, or she did neither."
? gym_daily(taylor).
