born_multiple(X) => spends_time_siblings(X). @ "People who are born in a multiple birth with siblings spend a lot of time hanging out with and playing with their siblings."
siblings_born_together(X) => born_multiple(X). @ "If people have siblings who were born together, then they were born in a multiple birth."
complains_siblings(X) => siblings_born_together(X). @ "If people complain often about annoying siblings, then they have siblings who were born together."
lives_home(X) => not lives_with_strangers(X). @ "If people live at home, then they do not live with strangers."
spends_time_siblings(X) => lives_home(X). @ "If people spend a lot of time hanging out with and playing with their siblings, then they often live at home."
born_multiple(luke) => lives_with_strangers(luke). @ "Luke either is a baby born in a multiple birth and live with strangers, or is not a baby born in a multiple birth and does not live with strangers"
lives_with_strangers(luke) => born_multiple(luke). @ "Luke either is a baby born in a multiple birth and live with strangers, or is not a baby born in a multiple birth and does not live with strangers"
not born_multiple(luke) => not lives_with_strangers(luke). @ "Luke either is a baby born in a multiple birth and live with strangers, or is not a baby born in a multiple birth and does not live with strangers"
not lives_with_strangers(luke) => not born_multiple(luke). @ "Luke either is a baby born in a multiple birth and live with strangers, or is not a baby born in a multiple birth and does not live with strangers"
? spends_time_siblings(luke).
