# Entities: zelda = The Legend of Zelda, fifa22 = FIFA 22
japanese_company(some_company_1). @ "A Japanese game company"
created(some_company_1, zelda). @ "created the game the Legend of Zelda"
top10(G) => made_by_japanese_company(G). @ "All games on the Top 10 list are made by Japanese game companies."
sells_more_than_million(G) => top10(G). @ "If a game sells more than one million copies, then it will be included in the Top 10 list."
sells_more_than_million(zelda). @ "The Legend of Zelda sold more than one million copies."
? made_by_japanese_company(fifa22).
