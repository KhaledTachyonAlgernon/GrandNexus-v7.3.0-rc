same(ailton_silva, ailton). @ "Ailton Silva, born in 1995, is commonly known as Ailton."
football_player(ailton). @ "Ailton is a football player"
loaned_out(ailton, braga). @ "was loaned out to Braga"
brazilian(ailton_silva). @ "Ailton Silva is a Brazilian footballer"
plays_for(ailton_silva, nautico). @ "plays for Náutico"
football_club(nautico). @ "Náutico is a football club"
