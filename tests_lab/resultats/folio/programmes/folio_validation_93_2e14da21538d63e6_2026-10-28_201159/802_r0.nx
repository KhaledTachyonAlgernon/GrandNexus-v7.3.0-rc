show(some_show_1). @ "Some show airing at 8 pm on Monday"
airs_monday_8pm(some_show_1). @ "Some show airing at 8 pm on Monday"
gives_roses(some_show_1). @ "gives out roses on TV"
gives_roses(S) => episode_of_bachelor(S). @ "If a show gives out roses on TV, then the show is an episode of The Bachelor."
portrays_real_lives(the_bachelor). @ "The Bachelor portrays the lives of real people."
show(S) & portrays_real_lives(S) => reality_tv(S). @ "All shows portraying the lives of real people are reality TV shows."
show(breaking_bad). @ "Breaking Bad is a show."
not reality_tv(breaking_bad). @ "Breaking Bad is not a reality TV show."
? airs_monday_8pm(breaking_bad).
