at_mixer(V) => grand_slam_champion(V) | oscar_actor(V). @ "Everyone at the mixer is a Grand Slam champion or an Oscar-nominated actor."
grand_slam_champion(V) & at_mixer(V) => tennis_pro(V). @ "Every Grand Slam champion at the mixer is a professional tennis player."
oscar_actor(V) & at_mixer(V) => celebrity(V). @ "All Oscar-nominated actors at the mixer are celebrities."
tennis_pro(V) & at_mixer(V) => athlete(V). @ "All professional tennis players at the mixer are athletes."
celebrity(V) & at_mixer(V) => well_paid(V). @ "If a person at the mixer is a celebrity, then they are well paid."
athlete(V) & at_mixer(V) => famous(V). @ "If a person at the mixer is an athlete, then they are famous."
well_paid(V) & at_mixer(V) => tax_haven_resident(V). @ "All well-paid people at the mixer live in tax havens."
at_mixer(djokovic). @ "Djokovic is at the mixer"
famous(djokovic) & athlete(djokovic) => well_paid(djokovic). @ "if Djokovic is a famous athlete, then Djokovic is well-paid"
? grand_slam_champion(djokovic).
