nlp_task(V) => language_generation_task(V) | language_understanding_task(V). @ "A natural language processing task can be categorized as either a language generation task or a language understanding task."
nlp_task(V) & output_is_text_sequence(V) => language_generation_task(V). @ "If the output of a natural language processing task is a text sequence, then it is a language generation task."
nlp_task(machine_translation). @ "Machine translation is a natural language processing task."
output_is_text_sequence(machine_translation). @ "The output of machine translation is a text sequence."
? language_generation_task(machine_translation).
