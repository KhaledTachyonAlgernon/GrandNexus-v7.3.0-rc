mountain_range(picuris_mountains). @ "The Picuris Mountains are a mountain range"
in(picuris_mountains, new_mexico) | in(picuris_mountains, texas). @ "in New Mexico or Texas"
visited(juan_de_onate, picuris_mountains). @ "Juan de Onate visited the Picuris Mountains"
mine(harding_pegmatite_mine). @ "The Harding Pegmatite Mine"
located_in(harding_pegmatite_mine, picuris_mountains). @ "located in the Picuris Mountains"
donated(harding_pegmatite_mine). @ "was donated"
mine(M) & located_in(M, R) => has_mine(R, M). @ "mountain ranges in texas that have mines"
mountain_range(R) & in(R, texas) & has_mine(R, M) => not donated(M). @ "There are no mountain ranges in texas that have mines that have been donated."
? mountain_range(R) & in(R, new_mexico) & visited(juan_de_onate, R).
