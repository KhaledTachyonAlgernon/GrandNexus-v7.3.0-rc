romance(V) => indo_european(V). @ "All Romance languages are Indo-European languages"
language_family(romance). @ "Romance languages are a language family"
romance(V) => member(V, romance). @ "Romance languages are a language family"
member(X, F) & member(Y, F) => related(X, Y). @ "All languages within a language family are related to each other"
romance(french). @ "French and Spanish are both Romance languages"
romance(spanish). @ "French and Spanish are both Romance languages"
related(german, spanish). @ "German is related to Spanish"
not related(basque, french). @ "Basque is not related to any other language"
not related(basque, spanish). @ "Basque is not related to any other language"
* member(Y, romance) & not related(X, Y) => not romance(X).
? romance(basque).
