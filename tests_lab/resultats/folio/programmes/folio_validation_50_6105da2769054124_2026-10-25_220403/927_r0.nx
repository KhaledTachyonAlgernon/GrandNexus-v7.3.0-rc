zaha_style(S) & adores(max, S) => interesting_geometries(S). @ "All of Zaha Hadid's design styles that Max adores have interesting geometries."
brutalist(S) & adores(max, S) => not interesting_geometries(S). @ "No brutalist buildings that Max adores have interesting geometries."
adores(max, S) & not zaha_style(S) => kelly_style(S). @ "Every style that Max adores is either Zaha Hadid's design style or Kelly Wearstler's design style."
kelly_style(S) & adores(max, S) => evocative(S). @ "All of Kelly Wearstler's design styles that Max adores are evocative."
kelly_style(S) & adores(max, S) => dreamy(S). @ "All of Kelly Wearstler's design styles that Max adores are dreamy."
design_by(max, D) & adores(max, D) & interesting_geometries(D) => brutalist(D). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
design_by(max, D) & adores(max, D) & interesting_geometries(D) => evocative(D). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
? design_by(max, D) & brutalist(D).
