library_worker(V) => not cs(V). @ "None of the students who currently work in the library are from the computer science department."
parttime(V) => library_worker(V). @ "All of the students with part-time jobs offered by the university currently work in the library."
database(V) => cs(V). @ "All of the students who are taking the database course are from the computer science department."
david_class(V) => database(V). @ "All of the students taking a class with Professor David are taking the database course."
lab(V) => david_class(V). @ "All students working in the lab are taking a class with Professor David."
lab(james). @ "James is a student working in the lab."
# cannot express: "James doesn't work in the lab or have a part-time job offered by the university."
? not parttime(james).
