eats_salads(X) => conscious(X). @ "All people who eat salads regularly are very conscious about their health and eating habits."
grew_up_healthy(X) => eats_salads(X). @ "All people who grew up in health-conscious childhood homes eat salads regularly."
fulfills_nutrition(X) => grew_up_healthy(X). @ "All people who fulfill their daily nutritional intakes grew up in health-conscious childhood homes."
disregards(X) => not conscious(X). @ "All people who disregard their physical well-being are not very conscious about their health and eating habits."
gym_daily(X) => fulfills_nutrition(X). @ "If people visit the gym at least once a day, then they always fulfill their daily nutritional intakes."
grew_up_healthy(taylor) => disregards(taylor). @ "Taylor either grew up in a health-conscious childhood home and disregard her physical well-being, or she did neither."
disregards(taylor) => grew_up_healthy(taylor). @ "Taylor either grew up in a health-conscious childhood home and disregard her physical well-being, or she did neither."
not grew_up_healthy(taylor) => not disregards(taylor). @ "Taylor either grew up in a health-conscious childhood home and disregard her physical well-being, or she did neither."
not disregards(taylor) => not grew_up_healthy(taylor). @ "Taylor either grew up in a health-conscious childhood home and disregard her physical well-being, or she did neither."
? eats_salads(taylor).
