deadly_disease(V) => low_survival_rate(V). @ "If something is a deadly disease, then it comes with a low survival rate."
severe_cancer(V) => deadly_disease(V). @ "Severe cancers are deadly diseases."
bile_duct_cancer(V) => severe_cancer(V). @ "Bile duct cancer is a severe form cancer."
cholangiocarcinoma(V) => bile_duct_cancer(V). @ "All Cholangiocarcinoma is bile duct cancer."
low_survival_rate(mild_flu). @ "Mild flu comes with a low survival rate."
not bile_duct_cancer(colorectal_cancer) | not low_survival_rate(colorectal_cancer). @ "Colorectal cancer is not both a bile duct cancer and with a low survival rate."
? severe_cancer(colorectal_cancer).
