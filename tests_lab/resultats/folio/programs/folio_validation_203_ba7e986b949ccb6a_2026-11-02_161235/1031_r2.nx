ranked(V) => active(V). @ "If someone is ranked highly by the Women's Tennis Association, then they are one of the most active players in major tennis."
lost_iga(V) => ranked(V). @ "Everyone who lost to Iga Świątek at Roland Garros 2022 is ranked highly by the Women's Tennis Association."
female_rg(V) => lost_iga(V). @ "All female tennis players at Roland Garros 2022 lost to Iga Świątek."
player_rg(V) => female_rg(V) | male_rg(V). @ "All tennis players at Roland Garros 2022 are either female or male."
male_rg(V) => lost_nadal(V). @ "All male tennis players at Roland Garros in 2022 lost to Rafael Nadal."
ranked(coco) => not male_rg(coco). @ "If Coco Gauff is ranked highly by the Women's Tennis Association or lost to Rafael Nadal, then Coco Gauff is not a male tennis player at Roland Garros 2022."
lost_nadal(coco) => not male_rg(coco). @ "If Coco Gauff is ranked highly by the Women's Tennis Association or lost to Rafael Nadal, then Coco Gauff is not a male tennis player at Roland Garros 2022."
player_rg(coco). @ "Coco Gauff is at Roland Garros 2022."
? not (lost_iga(coco) & active(coco)).
