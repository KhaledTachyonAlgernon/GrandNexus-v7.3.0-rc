book(V) => contain(V, knowledge). @ "Books contain tons of knowledge."
read(P, B) & book(B) => gain_knowledge(P). @ "When a person reads a book, that person gains knowledge."
gain_knowledge(P) => smarter(P). @ "If a person gains knowledge, they become smarter."
read(harry, walden). @ "Harry read the book “Walden” by Henry Thoreau."
book(walden). @ "the book “Walden”"
? contain(walden, knowledge).
