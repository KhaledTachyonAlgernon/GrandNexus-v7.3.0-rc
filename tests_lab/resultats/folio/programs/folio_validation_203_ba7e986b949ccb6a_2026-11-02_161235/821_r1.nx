growth_stock(V) => rapid_profit(V). @ "All growth stocks are bought to earn profits from rapid price appreciation."
rapid_profit(V) => not suitable_retirement(V). @ "If the stock price is bought to earn profits from rapid price appreciation, then it is not suitable for a retirement fund."
stock(some_stock_1). @ "Some stocks are growth stocks."
growth_stock(some_stock_1). @ "Some stocks are growth stocks."
mature_stock(V) => suitable_retirement(V). @ "All mature stocks are suitable for a retirement fund."
mature_stock(ko). @ "KO is a mature stock."
? not (growth_stock(ko) | rapid_profit(ko)) | (not stock(ko) & not volatile(ko)).
