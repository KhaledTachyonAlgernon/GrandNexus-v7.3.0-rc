managed_building(some_b_1). @ "Pets are allowed in some managed buildings."
allows_pets(some_b_1). @ "Pets are allowed in some managed buildings."
owns(tom, fluffy). @ "Fluffy is Tom's cat."
cat(fluffy). @ "Fluffy is Tom's cat."
cat(V) => pet(V). @ "Cats are pets."
managed_building(olive_garden). @ "The Olive Garden is a managed building."
monthly_rent(olive_garden, 2000). @ "The monthly rent at the Olive Garden is $2000."
more(2000, 1500). @ "$2000 is more than $1500."
managed_building(B) & allowed_with(tom, fluffy) & deposit_at_most_1500(B) => rent(tom, B). @ "Tom will rent an apartment in a managed building if he is allowed to move in with Fluffy, and the security deposit is no more than $1500."
managed_building(B) & allows_pets(B) & person(X) & pet(P) => allowed_with(X, P). @ "If a managed building allows pets, then people are allowed to move in with a pet."
? rent(tom, olive_garden).
