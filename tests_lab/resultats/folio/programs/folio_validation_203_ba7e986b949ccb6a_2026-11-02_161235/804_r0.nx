show(s1). @ "Some show airing at 8 pm on Monday"
airs_monday_8pm(s1). @ "Some show airing at 8 pm on Monday"
gives_roses(s1). @ "gives out roses on TV"
show(X) & gives_roses(X) => episode_of(X, the_bachelor). @ "If a show gives out roses on TV, then the show is an episode of The Bachelor."
portrays_real(the_bachelor). @ "The Bachelor portrays the lives of real people."
show(X) & portrays_real(X) => reality_tv(X). @ "All shows portraying the lives of real people are reality TV shows."
show(breaking_bad). @ "Breaking Bad is a show."
not reality_tv(breaking_bad). @ "Breaking Bad is not a reality TV show."
* episode_of(X, Y) & portrays_real(Y) => portrays_real(X).
? gives_roses(breaking_bad) => airs_monday_8pm(breaking_bad).
