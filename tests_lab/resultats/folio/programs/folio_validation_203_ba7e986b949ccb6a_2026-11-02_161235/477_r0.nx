managed_building(some_building_1). @ "Pets are allowed in some managed buildings."
allows_pets(some_building_1). @ "Pets are allowed in some managed buildings."
managed_building(B) & rents_in(P, B) => deposit_required(P, B). @ "A deposit is required to rent an apartment in a managed building."
# cannot express: "The security deposit can be either equal to the monthly rent at a managed building or more."
owns(tom, fluffy). @ "Fluffy is Tom's cat."
cat(fluffy). @ "Fluffy is Tom's cat."
cat(V) => pet(V). @ "Cats are pets."
managed_building(olive_garden). @ "The Olive Garden is a managed building."
monthly_rent(olive_garden, 2000). @ "The monthly rent at the Olive Garden is $2000."
more_than(2000, 1500). @ "$2000 is more than $1500."
allowed_move_in(tom, B, fluffy) & deposit_at_most(B, 1500) => rents_in(tom, B). @ "Tom will rent an apartment in a managed building if he is allowed to move in with Fluffy, and the security deposit is no more than $1500."
managed_building(B) & allows_pets(B) & pet(P) & person(X) => allowed_move_in(X, B, P). @ "If a managed building allows pets, then people are allowed to move in with a pet."
? allowed_move_in(tom, olive_garden, fluffy).
