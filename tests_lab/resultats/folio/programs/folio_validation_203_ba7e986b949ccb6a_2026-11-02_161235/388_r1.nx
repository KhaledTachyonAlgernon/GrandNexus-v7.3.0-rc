ml_algorithm(V) => supervised(V) | unsupervised(V) | reinforcement(V). @ "Machine Learning algorithms can be categorized as supervised learning, unsupervised learning, and reinforcement learning."
unsupervised(V) => not requires_labeled(V). @ "Unsupervised learning algorithms do not require labeled data."
ml_algorithm(alg_sum). @ "The state-of-the-art text summarization model is trained with machine learning algorithms."
trains(alg_sum, sota_model). @ "The state-of-the-art text summarization model is trained with machine learning algorithms."
reinforcement(V) => not trains(V, sota_model). @ "Reinforcement learning is not used to train the state-of-the-art text summarization model."
requires_labeled(alg_sum). @ "The Machine Learning algorithm for training text summarization models requires labeled data."
? supervised(alg_sum) & trains(alg_sum, sota_model).
