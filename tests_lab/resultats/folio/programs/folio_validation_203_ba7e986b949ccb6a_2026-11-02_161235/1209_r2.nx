employee(V) & schedule_meeting(V) => at_company_today(V). @ "All employees who schedule a meeting with their customers will go to the company building today."
lunch_company(V) => schedule_meeting(V). @ "Everyone who has lunch in the company building schedules meetings with their customers."
employee(V) => lunch_company(V) | lunch_home(V). @ "Employees have lunch either in the company building or at home."
employee(V) & lunch_company(V) => not lunch_home(V). @ "Employees have lunch either in the company building or at home."
employee(V) & lunch_home(V) => remote(V). @ "If an employee has lunch at home, they are working remotely from home."
employee(V) & in_other_country(V) => remote(V). @ "All employees who are in other countries work remotely from home."
manager(V) => not remote(V). @ "No managers work remotely from home."
at_company_today(james) => manager(james). @ "James will appear in the company today if and only if he is a manager."
manager(james) => at_company_today(james). @ "James will appear in the company today if and only if he is a manager."
? not lunch_company(james).
