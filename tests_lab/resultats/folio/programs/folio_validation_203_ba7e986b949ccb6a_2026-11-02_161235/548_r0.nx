international_student(mike). @ "Mike is an international student."
international_student(V) & in_us(V) => f1_visa(V) | j1_visa(V). @ "International students in the US have either an F1 visa or a J1 visa."
international_student(V) & in_us(V) & f1_visa(V) & wants_work(V) => apply_cpt(V) | apply_opt(V). @ "An international student in the US with an F1 visa needs to apply for CPT or OPT if the student wants to work in the US."
wants_work(mike) => apply_cpt(mike). @ "Mike needs to apply for CPT if he wants to work in the US."
? f1_visa(mike).
