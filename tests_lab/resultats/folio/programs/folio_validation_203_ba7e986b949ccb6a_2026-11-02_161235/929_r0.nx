adores(max, V) & zaha(V) => interesting_geometries(V). @ "All of Zaha Hadid's design styles that Max adores have interesting geometries."
adores(max, V) & brutalist(V) => not interesting_geometries(V). @ "No brutalist buildings that Max adores have interesting geometries."
adores(max, V) => zaha(V) | kelly(V). @ "Every style that Max adores is either Zaha Hadid's design style or Kelly Wearstler's design style."
adores(max, V) & kelly(V) => evocative(V). @ "All of Kelly Wearstler's design styles that Max adores are evocative."
adores(max, V) & kelly(V) => dreamy(V). @ "All of Kelly Wearstler's design styles that Max adores are dreamy."
design_by_max(V) & adores(max, V) & interesting_geometries(V) => brutalist(V). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
design_by_max(V) & adores(max, V) & interesting_geometries(V) => evocative(V). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
design_by_max(d). @ "A design by Max"
adores(max, d). @ "a design by Max that he adores"
? evocative(d) | dreamy(d).
