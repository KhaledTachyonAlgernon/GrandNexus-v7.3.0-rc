japanese_company(company_zelda). @ "A Japanese game company"
created(company_zelda, zelda). @ "created the game the Legend of Zelda"
top10(G) & made_by(G, C) => japanese_company(C). @ "All games on the Top 10 list are made by Japanese game companies."
sells_over_million(G) => top10(G). @ "If a game sells more than one million copies, then it will be included in the Top 10 list."
sells_over_million(zelda). @ "The Legend of Zelda sold more than one million copies."
