let gre_cost = 205.
cost(gre_test, gre_cost). @ "It costs $205 to take the GRE test"
gre_applicant(V) & prove_hardship(V) => provides_aid(ets, V). @ "ETS provides financial aid to those GRE applicants who prove economic hardship."
single_parent(V) => prove_hardship(V). @ "Those living in single-parent families or having few resources available to them can prove economic hardship."
few_resources(V) => prove_hardship(V). @ "Those living in single-parent families or having few resources available to them can prove economic hardship."
single_parent(tom). @ "Tom lives in a single-parent family."
few_resources(tom). @ "Tom has few resources available to them."
gre_applicant(tom). @ "Tom is applying to take the GRE test."
? gre_applicant(V) => not provides_aid(ets, V).
