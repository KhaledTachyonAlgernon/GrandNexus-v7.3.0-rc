work_library(V) => not from_cs(V). @ "None of the students who currently work in the library are from the computer science department."
parttime_job(V) => work_library(V). @ "All of the students with part-time jobs offered by the university currently work in the library."
take_database(V) => from_cs(V). @ "All of the students who are taking the database course are from the computer science department."
take_david(V) => take_database(V). @ "All of the students taking a class with Professor David are taking the database course."
work_lab(V) => take_david(V). @ "All students working in the lab are taking a class with Professor David."
work_lab(james). @ "James is a student working in the lab."
not work_lab(james) | not parttime_job(james). @ "James doesn't work in the lab or have a part-time job offered by the university."
? not parttime_job(james).
