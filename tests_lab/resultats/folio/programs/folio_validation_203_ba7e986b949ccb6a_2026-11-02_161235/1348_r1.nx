pet(peter, V) & mammal(V) => animal(V). @ "All of Peter's pets that are mammals are also animals."
monkey(V) => mammal(V). @ "All monkeys are mammals."
pet(peter, V) => monkey(V) | bird(V). @ "Peter's pets are all either monkeys or birds."
pet(peter, V) & bird(V) => fly(V). @ "Peter's birds can fly."
animal(V) & pet(peter, V) => breathe(V). @ "All animals that are Peter's pets can breathe."
pet(peter, V) & fly(V) => has_wings(V). @ "If Peter's pet can fly, then it has wings."
pet(peter, rock). @ "Rock is Peter's pet."
fly(rock) | bird(rock) | not breathe(rock). @ "Rock can fly, or Rock is a bird, or Rock cannot breathe."
? monkey(rock).
