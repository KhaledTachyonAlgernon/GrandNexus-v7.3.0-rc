zh_style(V) & adored(V) => interesting_geometries(V). @ "All of Zaha Hadid's design styles that Max adores have interesting geometries."
brutalist(V) & adored(V) => not interesting_geometries(V). @ "No brutalist buildings that Max adores have interesting geometries."
adored(V) => zh_style(V) | kw_style(V). @ "Every style that Max adores is either Zaha Hadid's design style or Kelly Wearstler's design style."
kw_style(V) & adored(V) => evocative(V). @ "All of Kelly Wearstler's design styles that Max adores are evocative."
kw_style(V) & adored(V) => dreamy(V). @ "All of Kelly Wearstler's design styles that Max adores are dreamy."
design_by_max(V) & adored(V) & interesting_geometries(V) => brutalist(V). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
design_by_max(V) & adored(V) & interesting_geometries(V) => evocative(V). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
? brutalist(a_design).
