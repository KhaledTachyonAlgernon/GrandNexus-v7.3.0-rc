book(V) => contains_knowledge(V). @ "Books contain tons of knowledge."
reads(P, B) & book(B) => gains_knowledge(P). @ "When a person reads a book, that person gains knowledge."
gains_knowledge(P) => smarter(P). @ "If a person gains knowledge, they become smarter."
book(walden). @ "the book “Walden”"
reads(harry, walden). @ "Harry read the book “Walden” by Henry Thoreau."
? smarter(harry).
