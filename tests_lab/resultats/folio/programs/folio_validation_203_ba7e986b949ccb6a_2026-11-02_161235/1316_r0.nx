basketball_player(some_player_1). @ "Some professional basketball players are not American nationals."
not american(some_player_1). @ "Some professional basketball players are not American nationals."
basketball_player(V) => can_jump_shot(V). @ "All professional basketball players can do jump shots."
can_jump_shot(V) => leaps_straight(V). @ "If someone can jump shots, they leap straight into the air."
leaps_straight(V) => activates_legs(V). @ "If someone leaps straight into the air, they activate their leg muscles."
not activates_legs(yuri). @ "Yuri does not activate his leg muscles."
? leaps_straight(yuri) | (american(yuri) & basketball_player(yuri)).
