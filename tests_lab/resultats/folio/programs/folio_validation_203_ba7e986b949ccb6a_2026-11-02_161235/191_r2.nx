# "Dani Shapiro was born in Boston" cannot be derived: the text only says Boston is an American city and that Dani is American
novel(V) & written_by(V, P) => novel_writer(P). @ "If a book is a novel and it is written by a person, then the person is a novel writer."
american_writer(dani_shapiro). @ "Dani Shapiro is an American writer."
american(dani_shapiro). @ "Dani Shapiro is an American writer"
writer(dani_shapiro). @ "Dani Shapiro is an American writer"
born_in(P, C) & american_city(C) => american(P). @ "If a person is born in American City, the person is American."
written_by(family_history, dani_shapiro). @ "Family History is written by Dani Shapiro."
novel(family_history). @ "Family History is a novel written in 2003."
american_city(boston). @ "Boston is an American city."
podcast(family_secrets). @ "Dani Shapiro created a podcast called Family Secrets."
podcast(V) => not novel(V). @ "A podcast is not a novel."
? born_in(dani_shapiro, boston).
