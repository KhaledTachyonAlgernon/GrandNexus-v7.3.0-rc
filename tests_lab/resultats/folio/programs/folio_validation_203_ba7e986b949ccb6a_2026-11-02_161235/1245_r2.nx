library_worker(V) => not cs_student(V). @ "None of the students who currently work in the library are from the computer science department."
parttime_univ(V) => library_worker(V). @ "All of the students with part-time jobs offered by the university currently work in the library."
db_course(V) => cs_student(V). @ "All of the students who are taking the database course are from the computer science department."
david_class(V) => db_course(V). @ "All of the students taking a class with Professor David are taking the database course."
lab_worker(V) => david_class(V). @ "All students working in the lab are taking a class with Professor David."
lab_worker(james). @ "James is a student working in the lab."
not lab_worker(james) | not parttime_univ(james). @ "James doesn't work in the lab or have a part-time job offered by the university."
? not parttime_univ(james).
