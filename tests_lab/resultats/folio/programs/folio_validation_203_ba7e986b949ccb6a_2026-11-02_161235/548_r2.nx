us_international_student(V) => f1(V) | j1(V). @ "International students in the US have either an F1 visa or a J1 visa."
us_international_student(V) & f1(V) & wants_work(V) => needs(V, cpt) | needs(V, opt). @ "An international student in the US with an F1 visa needs to apply for CPT or OPT if the student wants to work in the US."
international_student(mike). @ "Mike is an international student."
wants_work(mike) => needs(mike, cpt). @ "Mike needs to apply for CPT if he wants to work in the US."
? f1(mike).
