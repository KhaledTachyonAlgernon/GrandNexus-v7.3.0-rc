ml(V) => supervised(V) | unsupervised(V) | reinforcement(V). @ "Machine Learning algorithms can be categorized as supervised learning, unsupervised learning, and reinforcement learning."
unsupervised(V) => not requires_labeled(V). @ "Unsupervised learning algorithms do not require labeled data."
ml(alg1). @ "trained with machine learning algorithms"
used_to_train(alg1, sota_model). @ "The state-of-the-art text summarization model is trained with machine learning algorithms."
reinforcement(V) => not used_to_train(V, sota_model). @ "Reinforcement learning is not used to train the state-of-the-art text summarization model."
requires_labeled(alg1). @ "The Machine Learning algorithm for training text summarization models requires labeled data."
? unsupervised(alg1) & used_to_train(alg1, sota_model).
