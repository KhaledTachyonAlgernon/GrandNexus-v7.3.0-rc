mountain_range(picuris_mountains). @ "The Picuris Mountains are a mountain range"
in(picuris_mountains, new_mexico) | in(picuris_mountains, texas). @ "in New Mexico or Texas"
visited(juan_de_onate, picuris_mountains). @ "Juan de Onate visited the Picuris Mountains"
mine(harding_pegmatite_mine). @ "The Harding Pegmatite Mine"
in(harding_pegmatite_mine, picuris_mountains). @ "located in the Picuris Mountains"
donated(harding_pegmatite_mine). @ "was donated"
in(X, M) & mine(X) & donated(X) => has_donated_mine(M). @ "mines that have been donated"
mountain_range(M) & has_donated_mine(M) => not in(M, texas). @ "There are no mountain ranges in texas that have mines that have been donated."
? mountain_range(picuris_mountains) & in(picuris_mountains, new_mexico) & visited(juan_de_onate, picuris_mountains).
