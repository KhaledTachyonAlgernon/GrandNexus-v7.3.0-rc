can_transport_multiple(V) => not one_seater(V). @ "If something can transport multiple passengers, then they are not one-seaters."
tesla_model_3(V) => can_transport_multiple(V). @ "All Tesla Model 3 can transport multiple passengers."
single_seat_ev(V) => one_seater(V). @ "All single-seat electric cars are one-seaters."
solo_ev(V) => single_seat_ev(V). @ "All Solo EV cars are single-seat electric cars."
not tesla_model_3(johns_car) => not single_seat_ev(johns_car). @ "If John's car is not a Tesla Model 3, then John's car is not a Tesla Model 3 or a single-seat electric car."
? not solo_ev(johns_car).
