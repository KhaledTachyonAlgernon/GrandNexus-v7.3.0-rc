ml_algorithm(supervised_learning). @ "Machine Learning algorithms can be categorized as supervised learning"
ml_algorithm(unsupervised_learning). @ "unsupervised learning"
ml_algorithm(reinforcement_learning). @ "reinforcement learning"
not requires_labeled(unsupervised_learning). @ "Unsupervised learning algorithms do not require labeled data."
not used_to_train(reinforcement_learning, sota_summarizer). @ "Reinforcement learning is not used to train the state-of-the-art text summarization model."
ml_algorithm(V) & used_to_train(V, sota_summarizer) => requires_labeled(V). @ "The Machine Learning algorithm for training text summarization models requires labeled data."
? used_to_train(unsupervised_learning, sota_summarizer).
