zaha_style(V) & adores(max, V) => interesting_geometries(V). @ "All of Zaha Hadid's design styles that Max adores have interesting geometries."
brutalist(V) & adores(max, V) => not interesting_geometries(V). @ "No brutalist buildings that Max adores have interesting geometries."
adores(max, V) => zaha_style(V) | kelly_style(V). @ "Every style that Max adores is either Zaha Hadid's design style or Kelly Wearstler's design style."
kelly_style(V) & adores(max, V) => evocative(V). @ "All of Kelly Wearstler's design styles that Max adores are evocative."
kelly_style(V) & adores(max, V) => dreamy(V). @ "All of Kelly Wearstler's design styles that Max adores are dreamy."
design_by_max(V) & adores(max, V) & interesting_geometries(V) => brutalist(V). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
design_by_max(V) & adores(max, V) & interesting_geometries(V) => evocative(V). @ "If a design by Max that he adores has interesting geometries, then the design is a brutalist building and evocative."
design_by_max(d1). @ "A design by Max"
? evocative(d1) | dreamy(d1).
