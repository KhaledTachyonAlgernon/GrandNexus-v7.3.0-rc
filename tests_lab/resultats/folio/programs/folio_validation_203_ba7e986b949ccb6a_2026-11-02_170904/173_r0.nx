book(V) => contain_knowledge(V). @ "Books contain tons of knowledge."
person(P) & book(B) & read(P, B) => gain_knowledge(P). @ "When a person reads a book, that person gains knowledge."
person(P) & gain_knowledge(P) => smarter(P). @ "If a person gains knowledge, they become smarter."
read(harry, walden). @ "Harry read the book “Walden” by Henry Thoreau."
book(walden). @ "the book “Walden”"
? person(V) & smarter(V) => gain_knowledge(V).
