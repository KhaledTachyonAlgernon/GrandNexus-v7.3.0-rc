likes(george, music) => wants_to_compose(george). @ "If George likes music, he wants to compose."
has_access(george, program) => can_compose(george). @ "If George has access to a program, he can compose."
can_compose(george) & wants_to_compose(george) => composes(george). @ "If George can compose and wants to compose, he will compose."
? likes(george, music) & has_access(george, program) => composes(george).
