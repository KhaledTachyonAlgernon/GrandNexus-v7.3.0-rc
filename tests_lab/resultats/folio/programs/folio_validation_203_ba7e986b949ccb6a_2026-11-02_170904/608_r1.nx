romance(french). @ "French and Spanish are both Romance languages"
romance(spanish). @ "French and Spanish are both Romance languages"
romance(V) => indo_european(V). @ "All Romance languages are Indo-European languages"
romance(X) & romance(Y) => related(X, Y). @ "All languages within a language family are related to each other"
related(german, spanish). @ "German is related to Spanish"
* romance(V) => language(V).
language(Y) => not related(basque, Y). @ "Basque is not related to any other language"
? romance(basque).
