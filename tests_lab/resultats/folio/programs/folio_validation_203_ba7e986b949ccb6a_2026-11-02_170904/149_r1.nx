sporting_event(summer_olympics). @ "The summer Olympic games is a sporting event"
held_in(last_summer_olympics, tokyo). @ "The last summer Olympic games was in Tokyo"
won_most_medals(united_states, tokyo). @ "The United States won the most medals in Tokyo"
* held_in(G, P) & won_most_medals(X, P) => won_most_medals(X, G).
? won_most_medals(united_states, last_summer_olympics).
