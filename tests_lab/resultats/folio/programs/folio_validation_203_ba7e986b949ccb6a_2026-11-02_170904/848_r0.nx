make_plans(V) => engaged(V). @ "All people who make wedding plans are people who are engaged."
invite_others(V) => make_plans(V). @ "All people who invite others to come to their ceremony make wedding plans."
well_attended_wedding(V) => invite_others(V). @ "Anyone who has a well-attended wedding invites others to come to their ceremony."
well_attended_wedding(some_person_1). @ "Some people that have well-attended weddings have larger families."
larger_family(some_person_1). @ "Some people that have well-attended weddings have larger families."
engaged(john) => not invite_others(john) | not make_plans(john). @ "If John is engaged, then John does not invite friends to their ceremony and make wedding plans."
larger_family(john) => well_attended_wedding(john) | invite_others(john). @ "If John has a larger family, then either John has a well-attended wedding or invites friends to their ceremony."
? engaged(john).
