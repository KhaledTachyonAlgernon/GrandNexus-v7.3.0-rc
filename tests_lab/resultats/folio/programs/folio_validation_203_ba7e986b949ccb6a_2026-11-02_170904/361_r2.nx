member_of(some_member_1, pappys). @ "starring members of Pappy's"
starred_in(some_member_1, badults). @ "starring members of Pappy's"
piloted_on(badults, bbc_three). @ "Badults was piloted in July 2013 on BBC Three"
# The question is checked on the BBC Three branch only. This refutes the "BBC Two or BBC Three" statement, since the counterexample uses BBC Three.
? member_of(X, pappys) & starred_in(X, S) => not piloted_on(S, bbc_three).
