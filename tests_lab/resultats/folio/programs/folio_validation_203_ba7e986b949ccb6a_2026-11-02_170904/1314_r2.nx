pro_bb_player(some_player_1). @ "Some professional basketball players are not American nationals."
not american(some_player_1). @ "Some professional basketball players are not American nationals."
pro_bb_player(V) => can_jump_shot(V). @ "All professional basketball players can do jump shots."
can_jump_shot(V) => leaps_straight_up(V). @ "If someone can jump shots, they leap straight into the air."
leaps_straight_up(V) => activates_leg_muscles(V). @ "If someone leaps straight into the air, they activate their leg muscles."
not activates_leg_muscles(yuri). @ "Yuri does not activate his leg muscles."
? not (american(yuri) & pro_bb_player(yuri)).
