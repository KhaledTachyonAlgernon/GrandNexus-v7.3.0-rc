show(some_show_1). @ "Some show airing at 8 pm on Monday"
airs_monday_8pm(some_show_1). @ "Some show airing at 8 pm on Monday"
gives_roses(some_show_1). @ "gives out roses on TV"
gives_roses(V) => episode_of(V, the_bachelor). @ "If a show gives out roses on TV, then the show is an episode of The Bachelor"
portrays_real(the_bachelor). @ "The Bachelor portrays the lives of real people"
portrays_real(V) => reality_tv(V). @ "All shows portraying the lives of real people are reality TV shows"
show(breaking_bad). @ "Breaking Bad is a show"
not reality_tv(breaking_bad). @ "Breaking Bad is not a reality TV show"
? not gives_roses(breaking_bad) | airs_monday_8pm(breaking_bad).
