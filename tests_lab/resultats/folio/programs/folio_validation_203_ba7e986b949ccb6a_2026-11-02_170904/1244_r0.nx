student(V) & works_library(V) => not cs_dept(V). @ "None of the students who currently work in the library are from the computer science department."
student(V) & parttime_univ(V) => works_library(V). @ "All of the students with part-time jobs offered by the university currently work in the library."
student(V) & takes_database(V) => cs_dept(V). @ "All of the students who are taking the database course are from the computer science department."
student(V) & takes_david(V) => takes_database(V). @ "All of the students taking a class with Professor David are taking the database course."
student(V) & works_lab(V) => takes_david(V). @ "All students working in the lab are taking a class with Professor David."
student(james). @ "James is a student working in the lab."
works_lab(james). @ "James is a student working in the lab."
not works_lab(james) | not parttime_univ(james). @ "James doesn't work in the lab or have a part-time job offered by the university."
? parttime_univ(james).
