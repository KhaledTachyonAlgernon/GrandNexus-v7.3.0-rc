nlp_task(V) => generation(V) | understanding(V). @ "A natural language processing task can be categorized as either a language generation task or a language understanding task."
generation(V) => not understanding(V). @ "categorized as either a language generation task or a language understanding task"
understanding(V) => not generation(V). @ "categorized as either a language generation task or a language understanding task"
nlp_task(V) & text_output(V) => generation(V). @ "If the output of a natural language processing task is a text sequence, then it is a language generation task."
nlp_task(machine_translation). @ "Machine translation is a natural language processing task."
text_output(machine_translation). @ "The output of machine translation is a text sequence."
? understanding(machine_translation).
