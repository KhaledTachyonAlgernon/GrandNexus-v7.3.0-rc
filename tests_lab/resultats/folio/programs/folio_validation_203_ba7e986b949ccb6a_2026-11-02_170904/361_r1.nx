british_sitcom(badults). @ "Badults is a British Sitcom series"
member_of_pappys(some_member_1). @ "starring members of Pappy's"
starred_in(some_member_1, badults). @ "starring members of Pappy's"
piloted_on(badults, bbc_three). @ "Badults was piloted in July 2013 on BBC Three"
* starred_in(P, S) & piloted_on(S, bbc_three) => starred_in_bbc_two_or_three_pilot(P).
* starred_in(P, S) & piloted_on(S, bbc_two) => starred_in_bbc_two_or_three_pilot(P).
? member_of_pappys(V) => not starred_in_bbc_two_or_three_pilot(V).
