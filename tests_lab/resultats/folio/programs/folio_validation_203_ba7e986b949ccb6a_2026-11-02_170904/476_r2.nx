managed_building(some_b_1). @ "Pets are allowed in some managed buildings."
allows_pets(some_b_1). @ "Pets are allowed in some managed buildings."
managed_building(V) => deposit_required(V). @ "A deposit is required to rent an apartment in a managed building."
cat(fluffy). @ "Fluffy is Tom's cat."
owns(tom, fluffy). @ "Fluffy is Tom's cat."
cat(V) => pet(V). @ "Cats are pets."
managed_building(olive_garden). @ "The Olive Garden is a managed building."
let n2000 = 2000.
let n1500 = 1500.
monthly_rent(olive_garden, n2000). @ "The monthly rent at the Olive Garden is $2000."
more_than(n2000, n1500). @ "$2000 is more than $1500."
managed_building(B) & allowed_move_in(tom, fluffy) & deposit_at_most_1500(B) => rents(tom, B). @ "Tom will rent an apartment in a managed building if he is allowed to move in with Fluffy, and the security deposit is no more than $1500."
managed_building(B) & allows_pets(B) & pet(P) => allowed_move_in(tom, P). @ "If a managed building allows pets, then people are allowed to move in with a pet."
? rents(tom, olive_garden).
