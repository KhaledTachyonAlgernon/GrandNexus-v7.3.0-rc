born_multiple(V) => spends_time_with_siblings(V). @ "People who are born in a multiple birth with siblings spend a lot of time hanging out with and playing with their siblings."
siblings_born_together(V) => born_multiple(V). @ "If people have siblings who were born together, then they were born in a multiple birth."
complains_annoying_siblings(V) => siblings_born_together(V). @ "If people complain often about annoying siblings, then they have siblings who were born together."
lives_at_home(V) => not lives_with_strangers(V). @ "If people live at home, then they do not live with strangers."
spends_time_with_siblings(V) => lives_at_home(V). @ "If people spend a lot of time hanging out with and playing with their siblings, then they often live at home."
born_multiple(luke) | not lives_with_strangers(luke). @ "Luke either is a baby born in a multiple birth and live with strangers, or is not a baby born in a multiple birth and does not live with strangers"
not born_multiple(luke) | lives_with_strangers(luke). @ "Luke either is a baby born in a multiple birth and live with strangers, or is not a baby born in a multiple birth and does not live with strangers"
? not born_multiple(luke) & not complains_annoying_siblings(luke).
