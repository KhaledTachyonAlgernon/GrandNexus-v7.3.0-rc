appropriate_all(F) => can_watch_without_guidance(F). @ "If a film is appropriate for people of all ages, then children can watch it without guidance from parents."
film(F) & excessive_content(F) => not can_watch_without_guidance(F). @ "If a film contains excessive erotic and violent content, children cannot watch it without guidance from their parents."
film(F) & rated_ga(F) => appropriate_all(F). @ "If a film is rated General Audience, then it is appropriate for people of all ages."
family_animated(F) => rated_ga(F). @ "All family-friendly animated films are rated General Audience."
frozen(F) => family_animated(F). @ "All movies in the Frozen series are family-friendly animated films."
film(hachi). @ "“Hachi: A dog’s Tale” is a film."
family_animated(hachi) | appropriate_all(hachi). @ "“Hachi: A dog’s Tale”  is either a family-friendly animated film or is appropriate for people of all ages."
* family_animated(F) => film(F).
? (excessive_content(hachi) & frozen(hachi)) | (not excessive_content(hachi) & not frozen(hachi)).
