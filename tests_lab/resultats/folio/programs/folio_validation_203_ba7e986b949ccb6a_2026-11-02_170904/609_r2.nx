romance(V) => indo_european(V). @ "All Romance languages are Indo-European languages"
language_family(romance). @ "Romance languages are a language family"
in_family(X, F) & in_family(Y, F) => related(X, Y). @ "All languages within a language family are related to each other"
romance(french). @ "French and Spanish are both Romance languages"
romance(spanish). @ "French and Spanish are both Romance languages"
* romance(V) => in_family(V, romance).
related(german, spanish). @ "German is related to Spanish"
# cannot express: "Basque is not related to any other language"
? romance(german).
