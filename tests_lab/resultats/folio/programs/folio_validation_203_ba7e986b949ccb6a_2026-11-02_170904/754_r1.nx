listed_yelp(V) => not many_negative(V). @ "If a restaurant is listed in Yelp’s recommendations, then the restaurant has not received many negative reviews."
rating_gt4(V) => listed_yelp(V). @ "All restaurants with a rating greater than four are listed in Yelp’s recommendations."
restaurant(some_restaurant_1). @ "Some restaurants that do not provide take-out service receive many negative reviews."
not takeout(some_restaurant_1). @ "Some restaurants that do not provide take-out service receive many negative reviews."
many_negative(some_restaurant_1). @ "Some restaurants that do not provide take-out service receive many negative reviews."
popular_local(V) => rating_gt4(V). @ "All restaurants that are popular among local residents have ratings greater than four."
rating_gt4(hamden_plaza_subway) | popular_local(hamden_plaza_subway). @ "The Hamden Plaza Subway store has a rating greater than four, or it is popular among local residents."
? not (takeout(hamden_plaza_subway) & many_negative(hamden_plaza_subway)) | (rating_gt4(hamden_plaza_subway) & not takeout(hamden_plaza_subway)).
