book(walden). @ "Harry read the book “Walden” by Henry Thoreau"
read(harry, walden). @ "Harry read the book “Walden” by Henry Thoreau"
book(B) => contains_knowledge(B). @ "Books contain tons of knowledge."
person(P) & book(B) & read(P, B) => gains_knowledge(P). @ "When a person reads a book, that person gains knowledge."
person(P) & gains_knowledge(P) => smarter(P). @ "If a person gains knowledge, they become smarter."
? person(V) & smarter(V) => gains_knowledge(V).
