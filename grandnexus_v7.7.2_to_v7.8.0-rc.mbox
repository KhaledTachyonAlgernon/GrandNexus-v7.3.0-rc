diff --git a/tests_lab/test_api_retry.py b/tests_lab/test_api_retry.py
new file mode 100644
index 0000000..4c6e89d
--- /dev/null
+++ b/tests_lab/test_api_retry.py
@@ -0,0 +1,116 @@
+"""Offline test (no API) of the retry of transient API errors in the translator (logbook 90): an unavailable or
+overloaded API is retried with growing waits and the reading succeeds once it answers; a non-transient error is raised
+at once; when the retries run out the last error is raised (the bench counts the reading as failed); the batch
+replay's Pending and errored batch requests are never retried; the SDK's own exception classes are recognised."""
+import sys, logging
+from types import SimpleNamespace
+logging.disable(logging.CRITICAL)
+sys.path.insert(0, ".")
+sys.path.insert(0, "tools")
+import grandnexus.llm_interface.translator_v5 as T
+from batch_runner import Pending
+
+waits = []
+T.SLEEP = waits.append                     # no real waiting in the test
+
+REPLY = "```nx\np(a). @ \"A is p\"\n? p(a).\n```"
+
+
+def err(name, status=None, headers=None):
+    cls = type(name, (Exception,), {})
+    e = cls(f"{name} (fake)")
+    if status is not None:
+        e.status_code = status
+    if headers is not None:
+        e.response = SimpleNamespace(headers=headers)
+    return e
+
+
+class Flaky:
+    """Raises the given errors in order, then answers."""
+    def __init__(self, errors):
+        self.errors, self.calls, self.messages = list(errors), 0, self
+
+    def create(self, **kw):
+        self.calls += 1
+        if self.errors:
+            raise self.errors.pop(0)
+        return SimpleNamespace(id="ok", model="fake", content=[SimpleNamespace(text=REPLY)],
+                               usage=SimpleNamespace(input_tokens=1, output_tokens=1))
+
+
+# 1. two transient errors (503, then 529 overloaded), then an answer: the reading succeeds, two retries logged
+c = Flaky([err("ServiceUnavailableError", 503), err("OverloadedError", 529)])
+tr = T.Translator(client=c, retry_waits=(5, 15, 30))
+out = tr.translate("A is p.", "Is A p?")
+assert c.calls == 3 and len(tr.receipts) == 1, (c.calls, len(tr.receipts))
+assert [x["status"] for x in tr.retry_log] == [503, 529] and len(waits) == 2
+assert 4.0 <= waits[0] <= 6.0 and 12.0 <= waits[1] <= 18.0, waits
+assert out["parsed"].facts, "the reading after the retries must be the normal one"
+
+# 2. connection error without status code (recognised by class name), and a retry-after header that asks for longer
+waits.clear()
+c = Flaky([err("APIConnectionError"), err("RateLimitError", 429, {"retry-after": "42"})])
+tr = T.Translator(client=c, retry_waits=(5, 15))
+tr.translate("A is p.", "Is A p?")
+assert c.calls == 3 and waits[1] >= 42, waits
+
+# 3. a non-transient error (bad request) is raised at once, without waiting
+waits.clear()
+c = Flaky([err("BadRequestError", 400)])
+tr = T.Translator(client=c, retry_waits=(5, 15))
+try:
+    tr.translate("A is p.", "Is A p?")
+    raise AssertionError("a 400 must be raised")
+except Exception as e:  # noqa: BLE001
+    assert type(e).__name__ == "BadRequestError" and c.calls == 1 and not waits and not tr.retry_log
+
+# 4. the retries run out: the last transient error is raised after len(waits) + 1 attempts
+waits.clear()
+c = Flaky([err("ServiceUnavailableError", 503) for _ in range(10)])
+tr = T.Translator(client=c, retry_waits=(5, 15, 30))
+try:
+    tr.translate("A is p.", "Is A p?")
+    raise AssertionError("must give up")
+except Exception as e:  # noqa: BLE001
+    assert type(e).__name__ == "ServiceUnavailableError" and c.calls == 4 and len(waits) == 3
+
+# 5. batch replay: Pending (BaseException) passes through untouched; an errored batch request (RuntimeError) too
+class Replay:
+    def __init__(self, exc): self.exc, self.calls, self.messages = exc, 0, self
+    def create(self, **kw):
+        self.calls += 1
+        raise self.exc
+for exc, kind in ((Pending("k"), Pending), (RuntimeError("overloaded_error"), RuntimeError)):
+    waits.clear()
+    c = Replay(exc)
+    tr = T.Translator(client=c, retry_waits=(5, 15))
+    try:
+        tr.translate("A is p.", "Is A p?")
+        raise AssertionError("must raise")
+    except kind:
+        pass
+    assert c.calls == 1 and not waits, (kind, c.calls)
+
+# 6. the default policy waits up to about 8 minutes in all
+assert 400 <= sum(T.DEFAULT_RETRY_WAITS) <= 600
+
+# 7. the real SDK exception classes, when the SDK is installed
+try:
+    import anthropic, httpx
+except ImportError:
+    print("anthropic or httpx not installed: SDK classes not checked")
+else:
+    req = httpx.Request("POST", "https://api.anthropic.com/v1/messages")
+    def sdk(name, status):
+        cls = getattr(anthropic, name, None) or anthropic.InternalServerError
+        return cls("x", response=httpx.Response(status, request=req), body=None)
+    for name, status in (("ServiceUnavailableError", 503), ("OverloadedError", 529), ("RateLimitError", 429),
+                         ("InternalServerError", 500)):
+        assert T.is_transient(sdk(name, status)), name
+    for name, status in (("BadRequestError", 400), ("AuthenticationError", 401), ("NotFoundError", 404)):
+        assert not T.is_transient(sdk(name, status)), name
+    assert T.is_transient(anthropic.APIConnectionError(request=req))
+    assert T.is_transient(anthropic.APITimeoutError(request=req))
+    print(f"SDK {anthropic.__version__}: exception classes recognised")
+print("ALL OK")
diff --git a/tests_lab/test_living_diag.py b/tests_lab/test_living_diag.py
index db8e9bc..d120cbe 100644
--- a/tests_lab/test_living_diag.py
+++ b/tests_lab/test_living_diag.py
@@ -1,5 +1,7 @@
 """Offline test (no API) of the level-1 diagnosis tool (logbook 86) with the scripted translator on the debug seed 5:
-every fact, reading and question is logged, and seed 13 (the measured worlds) is refused."""
+every fact, reading and question is logged, and seed 13 (the measured worlds) is refused.
+Logbook 90: a reading that fails after the retries counts its facts as not read (the gate's denominator is every fact
+of the bench), moves come from the world, and the gate of an archived run can be recomputed with 0 API call."""
 import sys, logging
 logging.disable(logging.CRITICAL)
 sys.path.insert(0, "."); sys.path.insert(0, "tools"); sys.path.insert(0, "tests_lab")
@@ -17,6 +19,60 @@ assert v2["gate"]["pass"] and v2["right"] == v2["n"], v2.get("gate")
 assert any("'s home is in" in f["surface"] for w in v2["worlds"] for f in w["facts"]), "paraphraser v2 not used"
 assert not any("has a flat in" in f["surface"] for w in v2["worlds"] for f in w["facts"])
 assert any("has a flat in" in f["surface"] for w in out["worlds"] for f in w["facts"]), "v1 by default"
+# logbook 90: readings that fail after the retries (API unavailable)
+import grandnexus.llm_interface.translator_v5 as T
+from types import SimpleNamespace
+T.SLEEP = lambda s: None
+class Down(Scripted):
+    """The scripted reader behind an API that is unavailable for the sessions whose text contains a marker."""
+    def __init__(self, markers):
+        super().__init__(); self.markers, self.refused = markers, 0
+    def create(self, model, max_tokens, system, messages):
+        if any(m in messages[0]["content"] for m in self.markers):
+            self.refused += 1
+            e = type("ServiceUnavailableError", (Exception,), {})("down"); e.status_code = 503
+            raise e
+        return super().create(model, max_tokens, system, messages)
+args = ["--seed", "5", "--worlds", "2", "--sessions", "8", "--level", "1", "--paraphraser", "2", "--ontology", "2", "--gate", "--no-write"]
+w0 = v2["worlds"][0]
+first = [f for f in w0["facts"] if f["rel"] == "lives in" and not f["move"]]
+movers = [f["surface"].split("'")[0].split()[0] for f in first
+          if any(g["rel"] == "lives in" and g["move"] and g["surface"].startswith(f["surface"].split("'")[0].split()[0])
+                 and g["session"] > f["session"] for g in w0["facts"])]
+assert movers, "debug world 0 must hold a person who moves in a later session"
+target = next(f for f in first if f["surface"].startswith(movers[0]))
+down = Down([target["surface"]])
+v3 = D.main(args, client=down)
+assert down.refused == len(T.DEFAULT_RETRY_WAITS) + 1, down.refused        # retried, then given up
+assert v3["failed"]["readings"] == 1 and v3["failed"]["facts_in_failed_readings"] >= 1
+lost = [f for w in v3["worlds"] for f in w["facts"] if f["reading_failed"]]
+assert lost and not any(f["read_as_expected"] for f in lost)
+n_facts = lambda o: sum(len(w["facts"]) for w in o["worlds"])
+assert n_facts(v3) == n_facts(v2), "every fact of the bench stays in the log"
+assert v3["gate"]["n_first_residences"] == v2["gate"]["n_first_residences"], "moves come from the world, not the readings"
+assert v3["gate"]["first_residences"] < 1.0 and v3["gate"]["failed_readings"] == 1
+moved_later = [f for f in v3["worlds"][0]["facts"] if f["rel"] == "lives in" and f["surface"].startswith(movers[0])
+               and f["session"] > target["session"]]
+assert moved_later and all(f["move"] for f in moved_later), "a move after a failed first reading is still a move"
+# the whole API down: the gate fails, it is never computed on nothing
+v4 = D.main(args, client=Down(["TEXT:"]))
+assert v4["failed"]["readings"] == v4["failed"]["readings_total"] and not v4["gate"]["pass"]
+
+# the replay of the archived runs (0 API call) reproduces logbook 87 and recomputes the gate of logbook 89
+import glob
+a87 = sorted(glob.glob("tests_lab/resultats/living/living_diag_L1_2026-11-12_*.json"))
+a89 = sorted(glob.glob("tests_lab/resultats/living/living_diag_L1_2026-11-13_*.json"))
+if a87 and a89:
