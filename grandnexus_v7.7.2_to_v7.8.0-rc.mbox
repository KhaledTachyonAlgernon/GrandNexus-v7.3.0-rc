+        g = goal_of_program(prog)
+        if g is None:
+            return ("unknown", 0, "", []) if detail else ("unknown", 0)
+        goal, lits, universal = g
+        items: list = []
+        if universal:
+            found = self.path(lits[0].atom.pred, lits[-1].atom.pred, trivial)
+            items += [x for x in found if x not in items]
+        else:
